{
  "name": "marco-polo",
  "private": true,
  "version": "1.0.0",
  "description": "Draw an area on a map; it finds, measures and ranks the swimming pools in the aerial imagery.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace @marco-polo/web run dev",
    "build": "npm run typecheck && npm --workspace @marco-polo/web run build",
    "preview": "npm --workspace @marco-polo/web run preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/cli && tsc --noEmit -p packages/eval && tsc --noEmit -p tools/train && tsc --noEmit -p apps/web",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "parity": "playwright test -c tests/parity/playwright.config.ts",
    "bench": "playwright test -c tests/bench/playwright.config.ts",
    "verify": "node scripts/verify.mjs",
    "scan": "npm --workspace @marco-polo/cli run scan --",
    "eval": "npm --workspace @marco-polo/eval run eval --"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "jpeg-js": "^0.4.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
